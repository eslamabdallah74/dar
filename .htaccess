<IfModule mod_rewrite.c>
    RewriteEngine On

    # Canonical single-hop redirect: enforce HTTPS and non-www domain
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
