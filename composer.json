{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "spatie/laravel-activitylog": "^5.1",
        "tightenco/ziggy": "^2.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel/boost": "^2.10",
        "laravel/breeze": "^2.4",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.1",
        "rector/rector": "^2.7",
        "shipmonk/dead-code-detector": "^1.4",
        "tomasvotruba/cognitive-complexity": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "analyse": [
            "Composer\\Config::disableProcessTimeout",
            "phpstan analyse --memory-limit=2G"
        ],
        "analyse:baseline": [
            "Composer\\Config::disableProcessTimeout",
            "phpstan analyse --memory-limit=2G --generate-baseline=phpstan-baseline.neon --allow-empty-baseline"
        ],
        "refactor": [
            "Composer\\Config::disableProcessTimeout",
            "rector process"
        ],
        "refactor:check": [
            "Composer\\Config::disableProcessTimeout",
            "rector process --dry-run"
        ],
        "format": "pint",
        "format:check": "pint --test",
        "quality": [
            "Composer\\Config::disableProcessTimeout",
            "@format:check",
            "@refactor:check",
            "@analyse",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "scripts-descriptions": {
        "analyse": "PHPStan + Larastan (level 9, strict rules, dead code, cognitive complexity) against the committed baseline.",
        "analyse:baseline": "Regenerate phpstan-baseline.neon after fixing baselined errors (the baseline may only shrink).",
        "refactor": "Apply Rector's dead-code rules.",
        "refactor:check": "Fail when Rector finds dead code (unused variables, unused private parameters, dead branches).",
        "format": "Format PHP with Laravel Pint.",
        "format:check": "Fail when a PHP file is not formatted with Laravel Pint.",
        "quality": "The full PHP quality gate run by CI: format, dead code, static analysis and tests."
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
